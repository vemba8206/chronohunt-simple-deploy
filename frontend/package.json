{
  "name": "chronohunt-simple",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src vite.config.ts eslint.config.js scripts tests",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:database": "node tests/database.mjs",
    "test:sheet": "node tests/sheet-export.mjs",
    "deploy:prepare": "node scripts/prepare-vercel.mjs",
    "test:deployment": "node tests/deployment.mjs",
    "test:simple-database": "node tests/simple-database.mjs",
    "isolated:database": "node scripts/isolated-database.mjs",
    "test:simple-upgrade": "node tests/simple-upgrade.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.3",
    "@electric-sql/pglite": "^0.3.0"
  }
}
